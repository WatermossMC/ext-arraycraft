// $Id$
// vim:ft=javascript

ARG_ENABLE("arraycraft", "Enable PocketMine ChunkUtils2 extension", "no");

if (PHP_CHUNKUTILS2 != "no") {
	EXTENSION("arraycraft", "arraycraft.cpp", PHP_CHUNKUTILS2_SHARED, "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /permissive- /I" + configure_module_dirname + " /I" + configure_module_dirname + "/gsl/include /DGSL_THROW_ON_CONTRACT_VIOLATION=1");
	ADD_FLAG("CFLAGS_CHUNKUTILS2", "/EHsc /Qvec-report:1");
	ADD_SOURCES(
		configure_module_dirname + "/src",
		"PhpLightArray.cpp PhpPalettedBlockArray.cpp PhpSubChunkConverter.cpp",
		"arraycraft"
	);
}

